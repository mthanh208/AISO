{
  "manifest_version": 3,
  "name": "Universal AI Coding Bridge",
  "version": "1.2.0",
  "description": "Connect web AI (ChatGPT, Claude, Gemini) to local coding bridge",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://qwen.ai/*",
    "https://*.anthropic.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://qwen.ai/*",
        "https://*.anthropic.com/*",
        "https://*.google.com/*"
      ],
      "js": ["protocol.js", "bridge-client.js", "site-adapters.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
